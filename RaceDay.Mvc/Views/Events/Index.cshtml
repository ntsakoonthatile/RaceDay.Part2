@model System.Text.Json.JsonDocument

@{
    ViewData["Title"] = "Upcoming Events";
}

<h2 class="mb-4">Upcoming RaceDay Events</h2>

<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-5">
        <input name="search" class="form-control"
               placeholder="Search events"
               value="@ViewBag.Search" />
    </div>
    <div class="col-md-4">
        <input name="type" class="form-control"
               placeholder="Event type, e.g. Running"
               value="@ViewBag.Type" />
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary w-100">
            Find Events
        </button>
    </div>
</form>

@if (Model.RootElement.GetArrayLength() == 0)
{
    <p>No upcoming events found.</p>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model.RootElement.EnumerateArray())
        {
            var id = item.GetProperty("eventId").GetInt32();
            var name = item.GetProperty("name").GetString();
            var date = item.GetProperty("eventDate").GetDateTime();
            var location = item.GetProperty("location").GetString();
            var distance = item.GetProperty("distanceKm").GetDecimal();
            var eventType = item.GetProperty("eventType").GetString();

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5>@name</h5>
                        <p><strong>Date:</strong> @date.ToString("dd MMM yyyy")</p>
                        <p><strong>Location:</strong> @location</p>
                        <p><strong>Distance:</strong> @distance km</p>
                        <p><strong>Type:</strong> @eventType</p>

                        <a asp-controller="Events"
                           asp-action="Details"
                           asp-route-id="@id"
                           class="btn btn-primary">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}