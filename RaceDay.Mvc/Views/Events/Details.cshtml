@using System.Text.Json
@using Microsoft.AspNetCore.Http
@model System.Text.Json.JsonDocument

@{
    ViewData["Title"] = "Event Details";
    var item = Model.RootElement;
    int eventId = item.GetProperty("eventId").GetInt32();

    var name = item.GetProperty("name").GetString();
    var description = item.GetProperty("description").GetString();
    var location = item.GetProperty("location").GetString();
    var distance = item.GetProperty("distanceKm").GetDecimal();
    var date = item.GetProperty("eventDate").GetDateTime();

    string? banner = item.GetProperty("bannerImageUrl").GetString();

    var categories = (JsonElement)ViewBag.Categories;
}

<h2>@name</h2>

@if (!string.IsNullOrWhiteSpace(banner))
{
    <img src="@banner" alt="Event banner"
         class="img-fluid rounded mb-3"
         style="max-height:300px;object-fit:cover;width:100%" />
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <p>@description</p>
        <p><strong>Date:</strong> @date.ToString("dd MMM yyyy")</p>
        <p><strong>Location:</strong> @location</p>
        <p><strong>Distance:</strong> @distance km</p>
    </div>
</div>

<h4>Available Categories</h4>

@if (categories.GetArrayLength() == 0)
{
    <p>No categories have been added yet.</p>
}
else
{
    <ul class="list-group mb-4">
        @foreach (var category in categories.EnumerateArray())
        {
            var categoryName = category
            .GetProperty("categoryName").GetString();

            var categoryDescription = category
            .GetProperty("description").GetString();

            <li class="list-group-item">
                <strong>@categoryName</strong>
                <p class="mb-0">@categoryDescription</p>
            </li>
        }
    </ul>
}

@if (Context.Session.GetString("Role") == "Participant"
    && categories.GetArrayLength() > 0)
{
    <a asp-controller="Enrolment"
       asp-action="Enter"
       asp-route-eventId="@eventId"
       class="btn btn-success">
        Enter Event
    </a>
}

<a asp-action="Index" class="btn btn-secondary">
    Back to Events
</a>