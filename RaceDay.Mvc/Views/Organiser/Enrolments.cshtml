@using System.Text.Json
@model JsonDocument?

@{
    ViewData["Title"] = "Event Enrolments";
    int eventId = (int)ViewBag.EventId;
}

<h2>Event Enrolments</h2>

<p>View participants and update their enrolment status.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a asp-action="Events" class="btn btn-secondary mb-3">
    Back to Events
</a>

@if (Model == null ||
    Model.RootElement.ValueKind != JsonValueKind.Array ||
    Model.RootElement.GetArrayLength() == 0)
{
    <div class="alert alert-info">
        No participants have enrolled in this event yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Email</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Update Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.RootElement.EnumerateArray())
                {
                    int id = item.GetProperty("enrolmentId").GetInt32();
                    string? participant = item.GetProperty("participantName").GetString();
                    string? email = item.GetProperty("email").GetString();
                    string? category = item.GetProperty("categoryName").GetString();
                    string? status = item.GetProperty("status").GetString();

                    string badgeClass = status == "Confirmed"
                    ? "bg-success"
                    : status == "Pending"
                    ? "bg-warning text-dark"
                    : "bg-secondary";

                    <tr>
                        <td>@participant</td>
                        <td>@email</td>
                        <td>@category</td>
                        <td>
                            <span class="badge @badgeClass">@status</span>
                        </td>
                        <td>
                            <form asp-action="UpdateEnrolmentStatus"
                                  method="post"
                                  class="d-flex gap-2">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id" value="@id" />
                                <input type="hidden" name="eventId" value="@eventId" />

                                <select name="status" class="form-select form-select-sm">
                                    <option value="Pending">Pending</option>
                                    <option value="Confirmed">Confirmed</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>

                                <button type="submit"
                                        class="btn btn-sm btn-primary">
                                    Update
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

