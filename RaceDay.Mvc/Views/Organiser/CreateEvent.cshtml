@using System.Text.Json
@model RaceDay.Mvc.Models.EventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<h2>Create New Event</h2>

<form asp-action="CreateEvent" method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="EventName" class="form-label"></label>
        <input asp-for="EventName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Distance" class="form-label"></label>
        <input asp-for="Distance" type="number"
               step="0.1" min="0.1" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="EventTypeId" class="form-label">
            Event Type
        </label>

        <select asp-for="EventTypeId" class="form-select">
            <option value="0">Select event type</option>

            @if (ViewBag.EventTypes is JsonElement types &&
                        types.ValueKind == JsonValueKind.Array)
            {
                @foreach (var type in types.EnumerateArray())
                {
                    int id = type.GetProperty("eventTypeId").GetInt32();
                    string? name = type.GetProperty("typeName").GetString();

                    <option value="@id">@name</option>
                }
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="BannerImage" class="form-label">
            Event Banner
        </label>
        <input asp-for="BannerImage" type="file"
               accept="image/png,image/jpeg,image/webp"
               class="form-control" />
        <small class="text-muted">
            File upload becomes available after Azure integration.
            Leave this blank when testing event creation now.
        </small>
    </div>

    <button type="submit" class="btn btn-success">
        Create Event
    </button>

    <a asp-action="Events" class="btn btn-secondary">Cancel</a>
</form>