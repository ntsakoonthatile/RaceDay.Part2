@model RaceDay.Mvc.Models.CategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<h2>Edit Event Category</h2>

<form asp-action="EditCategory" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="CategoryId" />
    <input type="hidden" asp-for="EventId" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="CategoryName" class="form-label"></label>
        <input asp-for="CategoryName" class="form-control" />
        <span asp-validation-for="CategoryName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description"
                  rows="3"
                  class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">
        Update Category
    </button>

    <a asp-action="Categories"
       asp-route-eventId="@Model.EventId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
